# Tempo API — safe example. Copy to .env.development.local (keep OUTSIDE git); never commit real values.
# Required values are validated at start-up; TEMPO_ENV=uat|production rejects insecure/missing ones.

TEMPO_ENV=local                       # local | test | uat | production

# Runtime URL: non-owner role `tempo_app` (subject to RLS). Password comes from your secret store.
TEMPO_DATABASE_URL=postgresql+psycopg://tempo_app:CHANGE_ME@localhost:5447/tempo
# Migration URL: `tempo_owner`, used only by `alembic` / `make migrate`. Never given to a running service.
TEMPO_DATABASE_MIGRATION_URL=postgresql+psycopg://tempo_owner:CHANGE_ME@localhost:5447/tempo

# Signs Tempo access tokens and kiosk credential digests. >= 32 random chars. Rotate to invalidate all sessions.
TEMPO_SESSION_SIGNING_KEY=
# Signs controlled-action tokens. >= 32 random chars.
TEMPO_ACTION_TOKEN_SECRET=

# Cookies: Secure is required outside local plain-http development.
TEMPO_SESSION_COOKIE_SECURE=false     # true in uat/production
TEMPO_CONSOLE_CORS_ORIGINS=http://localhost:5173

# OIDC (production identity provider is an OPEN DECISION — ADR-0001). Required in uat/production.
TEMPO_OIDC_ISSUER=
TEMPO_OIDC_AUDIENCE=                  # the OIDC client id
TEMPO_OIDC_JWKS_URL=
TEMPO_OIDC_CLIENT_SECRET=

# Local development identity provider. Refused unless TEMPO_ENV is local or test. NOT production authentication.
TEMPO_DEV_IDP_ENABLED=false
